# Backend API base URL (must include /api/v1)
#
# Android emulator : http://10.0.2.2:5000/api/v1   (default on Android, no need to set)
# iOS simulator    : http://localhost:5000/api/v1  (default)
# Real phone       : http://<YOUR-PC-IP>:5000/api/v1   e.g. http://192.168.1.5:5000/api/v1
#                    (phone and PC must be on the same Wi-Fi; find the IP with `ipconfig`)
EXPO_PUBLIC_API_URL=http://192.168.1.5:5000/api/v1
